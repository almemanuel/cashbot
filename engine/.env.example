# CashBot Environment Variables

# Binance Spot Testnet (https://testnet.binance.vision/)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Groq API (Agente Técnico - Llama 3.3 70B gratuito via https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API (Agente Sentimento - Gemini Flash gratuito via https://aistudio.google.com)
GEMINI_API_KEY=

# Neon Serverless PostgreSQL (https://neon.tech)
# Exemplo: postgresql://cashbot_owner:xxx@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Notificações no Celular via Telegram Bot (Gratuito)
# Crie seu bot no @BotFather no Telegram para obter o token
TELEGRAM_BOT_TOKEN=
# Obtenha seu chat_id enviando uma mensagem para o bot @userinfobot ou @getidsbot
TELEGRAM_CHAT_ID=

# Modo de Execução: True para simulação local/testnet com fundos virtuais, False para ordens reais na testnet
SIMULATION_MODE=True

